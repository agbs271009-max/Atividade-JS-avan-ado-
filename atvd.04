<!DOCTYPE html>
<html lang="pt-br">
<body style="font-family: sans-serif; padding: 20px;">
    <h3>Média Escolar</h3>
    <input type="number" id="nota1" placeholder="Nota 1">
    <input type="number" id="nota2" placeholder="Nota 2">
    <button onclick="calcularMedia()">Calcular</button>
    <h2 id="resultadoProfessor"></h2>

    <script>
        function calcularMedia() {
            const n1 = parseFloat(document.getElementById('nota1').value);
            const n2 = parseFloat(document.getElementById('nota2').value);
            const media = (n1 + n2) / 2;
            const display = document.getElementById('resultadoProfessor');

            if (media >= 7) {
                display.innerText = `Aprovado: ${media.toFixed(1)}`;
                display.style.color = "green";
            } else if (media >= 5) {
                display.innerText = `Recuperação: ${media.toFixed(1)}`;
                display.style.color = "orange";
            } else {
                display.innerText = `Reprovado: ${media.toFixed(1)}`;
                display.style.color = "red";
            }
        }
    </script>
</body>
</html>