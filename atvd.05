<!DOCTYPE html>
<html lang="pt-br">
<body style="font-family: sans-serif; padding: 20px;">
    <h3>Gerador de Tabuada</h3>
    <input type="number" id="numTabuada" placeholder="Número">
    <button onclick="gerarTabuada()">Gerar</button>
    <ul id="listaTabuada"></ul>

    <script>
        function gerarTabuada() {
            const num = document.getElementById('numTabuada').value;
            const lista = document.getElementById('listaTabuada');
            lista.innerHTML = "";
            for (let i = 1; i <= 10; i++) {
                let li = document.createElement('li');
                li.innerText = `${num} x ${i} = ${num * i}`;
                lista.appendChild(li);
            }
        }
    </script>
</body>
</html>